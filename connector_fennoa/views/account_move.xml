<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_fennoa" model="ir.ui.view">
        <field name="name">account.move.form.fennoa</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">

            <xpath expr="//button[@name='action_post'][2]" position="after">
                <button
                    name="action_post"
                    string="Send to Fennoa"
                    class="oe_highlight"
                    type="object"
                    groups="account.group_account_invoice"
                    data-hotkey="q"
                    context="{'validate_analytic': True}"
                    invisible="not fennoa_export or state == 'posted' or (fennoa_binding_count and move_type in ('out_invoice', 'out_refund'))"
                />
                <button
                    name="action_fennoa_export_record"
                    string="Send to Fennoa"
                    class="oe_highlight"
                    type="object"
                    data-hotkey="q"
                    groups="account.group_account_invoice"
                    invisible="not fennoa_export or state != 'posted' or fennoa_binding_count"
                />
            </xpath>

            <xpath expr="//div[@class='oe_button_box']" position="inside">
                <button
                    name="action_view_fennoa_bindings"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-external-link"
                    groups="base.group_erp_manager"
                    invisible="not fennoa_binding_count"
                >
                    <field
                        name="fennoa_binding_count"
                        widget="statinfo"
                        string="Fennoa bindings"
                    />
                </button>
            </xpath>

            <xpath expr="//notebook/page[last()]" position="after">
                <page string="Fennoa" name="fennoa">
                    <group>
                        <group colspan="2" string="Sending options">
                            <field name="fennoa_export" widget="boolean_toggle" />
                            <field
                                name="fennoa_delayed_send"
                                groups="base.group_no_one"
                                widget="boolean_toggle"
                            />
                            <field
                                name="fennoa_sent_date"
                                invisible="not fennoa_sent_date"
                            />
                            <field
                                name="fennoa_invoice_id"
                                invisible="not fennoa_invoice_id"
                            />
                            <field name="fennoa_binding_count" invisible="1" />
                        </group>
                        <group>
                            <button
                                name="action_fennoa_export_record"
                                type="object"
                                class="oe_highlight"
                                string="Export to Fennoa"
                                invisible="not fennoa_export"
                                colspan="2"
                            />
                        </group>
                        <group>
                            <button
                                name="action_fennoa_import_record"
                                type="object"
                                class=""
                                string="Update from Fennoa"
                                invisible="not fennoa_binding_count"
                                colspan="2"
                            />
                        </group>
                    </group>

                    <label
                        for="fennoa_binding_ids"
                        groups="base.group_erp_manager"
                        invisible="not fennoa_binding_ids"
                    />
                    <field
                        name="fennoa_binding_ids"
                        nolabel="1"
                        groups="base.group_erp_manager"
                        invisible="not fennoa_binding_ids"
                    >
                        <tree create="false" delete="false">
                            <field name="backend_id" readonly="1" />
                            <field name="res_id" readonly="1" />
                            <field name="res_model" readonly="1" />
                            <field name="external_id" readonly="1" />
                        </tree>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
