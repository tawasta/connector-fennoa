<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Tree view -->
    <record id="view_fennoa_binding_tree" model="ir.ui.view">
        <field name="name">fennoa.binding.tree</field>
        <field name="model">fennoa.binding</field>
        <field name="arch" type="xml">
            <tree>
                <field name="create_date" />
                <field name="backend_id" />
                <field name="method" />
                <field name="endpoint" />
                <field name="status_code" />
                <field name="successful" />
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_fennoa_binding_form" model="ir.ui.view">
        <field name="name">fennoa.binding.form</field>
        <field name="model">fennoa.binding</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="backend_id" />
                        <field name="method" />
                        <field name="endpoint" />
                        <field name="status_code" />
                        <field name="successful" />
                    </group>
                    <group string="Response">
                        <field name="response" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_fennoa_binding" model="ir.actions.act_window">
        <field name="name">Fennoa Bindings</field>
        <field name="res_model">fennoa.binding</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_fennoa_binding"
        name="Bindings"
        parent="menu_fennoa_root"
        action="action_fennoa_binding"
    />
</odoo>
