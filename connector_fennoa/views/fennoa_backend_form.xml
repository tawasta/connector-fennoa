<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_fennoa_backend_form" model="ir.ui.view">
        <field name="name">fennoa.backend.form</field>
        <field name="model">fennoa.backend</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_test_connection"
                        type="object"
                        string="Test Connection"
                        class="btn-primary"
                    />
                    <button
                        name="action_import_customers"
                        type="object"
                        string="Import Customers"
                        class="btn-primary"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="base_url" />
                        <field name="client_identifier" />
                        <field name="secret_key_b64" />
                        <field name="company_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
