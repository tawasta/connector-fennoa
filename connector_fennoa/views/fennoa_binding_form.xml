<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_fennoa_binding_form" model="ir.ui.view">
        <field name="name">fennoa.binding.form</field>
        <field name="model">fennoa.binding</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button
                            name="action_open_record"
                            class="oe_stat_button"
                            icon="fa-external-link"
                            type="object"
                        >
                            <div class="o_stat_info">
                                <span class="o_stat_text">Open record</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <field name="name" />
                        <field name="backend_id" />
                        <field name="company_id" />
                        <field name="res_model" />
                        <field name="res_id" />
                        <field name="external_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
