<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_cron_fennoa_payment_sync" model="ir.cron">
        <field name="name">Fennoa Payment Sync</field>
        <field name="model_id" ref="model_fennoa_backend"/>
        <field name="state">code</field>
        <field name="code">
            for backend in env['fennoa.backend'].search([]):
                backend.action_sync_payments()
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
