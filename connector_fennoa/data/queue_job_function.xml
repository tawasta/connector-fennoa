<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Fennoa: backend -->
    <record id="job_function_fennoa_backend_export_record" model="queue.job.function">
        <field name="model_id" ref="connector_fennoa.model_fennoa_backend" />
        <field name="method">_import_payments</field>
        <field name="channel_id" ref="channel_fennoa" />
    </record>

    <!-- Fennoa: invoices -->
    <record
        id="job_function_fennoa_account_move_export_record"
        model="queue.job.function"
    >
        <field name="model_id" ref="connector_fennoa.model_account_move" />
        <field name="method">_fennoa_export_record</field>
        <field name="channel_id" ref="channel_fennoa" />
    </record>

    <record
        id="job_function_fennoa_account_move_approve_invoice"
        model="queue.job.function"
    >
        <field name="model_id" ref="connector_fennoa.model_account_move" />
        <field name="method">action_fennoa_approve_invoice</field>
        <field name="channel_id" ref="channel_fennoa" />
    </record>

    <record
        id="job_function_fennoa_account_move_get_invoice_number"
        model="queue.job.function"
    >
        <field name="model_id" ref="connector_fennoa.model_account_move" />
        <field name="method">action_fennoa_get_invoice_details</field>
        <field name="channel_id" ref="channel_fennoa" />
        <field name="retry_pattern" eval="{1: 600, 5: 3600, 10: 86400}" />
    </record>

    <!-- Fennoa: Payments -->
    <record
        id="job_function_fennoa_account_payment_export_record"
        model="queue.job.function"
    >
        <field name="model_id" ref="connector_fennoa.model_account_payment" />
        <field name="method">_fennoa_export_record</field>
        <field name="channel_id" ref="channel_fennoa" />
    </record>

    <record
        id="job_function_fennoa_account_payment_import_record"
        model="queue.job.function"
    >
        <field name="model_id" ref="connector_fennoa.model_account_payment" />
        <field name="method">_fennoa_import_record</field>
        <field name="channel_id" ref="channel_fennoa" />
    </record>

    <!-- Fennoa: Partners -->
    <record
        id="job_function_fennoa_res_partner_export_record"
        model="queue.job.function"
    >
        <field name="model_id" ref="connector_fennoa.model_res_partner" />
        <field name="method">_fennoa_export_record</field>
        <field name="channel_id" ref="channel_fennoa" />
    </record>

    <record
        id="job_function_fennoa_res_partner_import_record"
        model="queue.job.function"
    >
        <field name="model_id" ref="connector_fennoa.model_res_partner" />
        <field name="method">_fennoa_import_record</field>
        <field name="channel_id" ref="channel_fennoa" />
    </record>

</odoo>
